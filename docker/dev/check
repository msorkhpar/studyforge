#!/bin/sh
# Run the framework's checks in the framework's build environment.
#
#     docker/dev/check                            the whole suite
#     docker/dev/check python3 -m tests.floor     the quality floor alone
#     docker/dev/check python3 -m pytest -k ruff  anything else
#
# ⭐ Every run first prints, on stderr, the image it runs — named by the CONTENT
# of its build inputs (the block below the attestation variable).
#
# ⭐ **Three variables cross into the container**, declared once in
# `compose.yaml`'s `environment:` block and set the ordinary way:
#
#     STUDYFORGE_VISUAL=required docker/dev/check      absence is a FAILURE
#     STUDYFORGE_VISUAL_BROWSER=/some/browser …        name one explicitly
#     STUDYFORGE_VISUAL_CAPTURES=/workspace/… …        keep the screenshots
#
# ⭐ **A fourth variable is read HERE and does not cross**, because it
# shapes the command this wrapper builds rather than anything inside:
#
#     STUDYFORGE_CHECK_TIMEOUT=300 docker/dev/check    bound the run at 300s
#
# ⛔ The outer bound is the block at the bottom of this file; read it before
# changing the figure.
#
# ⛔ Unset on the host means unset in there, so this wrapper decides nothing —
# it only stops the caller's answer being dropped at the boundary. ⚠️ The
# capture directory is a path INSIDE the container: only somewhere under
# `/workspace` reaches the checkout, and nothing is written there by default,
# because a capture's directory could be somebody's home, which is personal data.
#
# ⭐ On the host, the same work is the same command with the wrapper removed:
#
#     python3 -m pytest
#
# That is the design, not a coincidence. A build environment invoked
# differently from the host is one whose divergence you find out about late.
#
# ⛔ POSIX sh, and it uses only `docker`, `id` and shell builtins, because a
# contributor needs Docker and nothing else; a wrapper that reached for Python
# would quietly break that.
#
# ⛔ No path from this machine is written into any file. `ROOT` is derived from
# where this script sits and the uid/gid are read at run time.
set -eu

# The repository root: this file is at <root>/docker/dev/check.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

# Run as the invoking user so that anything the container writes into the
# bind-mounted checkout belongs to the person who ran it. ⛔ Without this the
# container writes as root and leaves files a contributor cannot delete.
#
# ⚠️ An already-set value wins, so a caller can ask for a different uid without
# editing anything — which is how `tests/docker/test_dev_image.py` exercises
# the unprivileged case, and how a rootless or CI runner would override it.
STUDYFORGE_UID=${STUDYFORGE_UID:-$(id -u)}
STUDYFORGE_GID=${STUDYFORGE_GID:-$(id -g)}
export STUDYFORGE_UID STUDYFORGE_GID

# ---------------------------------------------------------------------------
# ⛔ **ONE ENVIRONMENT, ONE IDENTIFIER: no build provenance.**
#
# ⚠️ `--build` at the bottom re-runs the exporter on every invocation, and
# BuildKit stamps two of the four digests it exports with build-time provenance:
# the attestation manifest and the manifest list indexing it. Byte-identical
# contents would then get fresh digests on every run, and
# `docker image inspect --format '{{.Id}}'` reports the manifest LIST, so two
# checkouts holding an identical environment would read different ids for it.
# ⭐ With the line below the attestation is never built, the list is not
# exported, and the two stable digests (config and manifest) are the only two
# left.
#
# ⚠️ **A VARIABLE AND NOT A FLAG, because nothing else works.**
# `docker compose run --build` accepts no `--provenance`; only
# `docker compose build` does, and this wrapper would then run two commands.
# ⛔ `compose.yaml`'s declarative `build: provenance: false` key is INERT with
# this Compose and buildx: the attestation is still exported and still moves.
# A `.env` beside `compose.yaml` does not carry it either: that file is
# interpolated into the YAML, not exported to the client. ⭐ Shipping the inert
# key anyway would be a decoration that READS like the fix.
#
# ⛔ **Set unconditionally, with no `${VAR:-…}` escape.** The other variables
# carry a CALLER's answer across a boundary; this one is the wrapper's own
# guarantee that a reading taken here is comparable to a reading taken in
# another checkout, and a caller who unset it would silently lose that.
#
# ⭐ **It is read by the docker CLIENT and does not cross.** What crosses is
# `compose.yaml`'s `environment:` block, which stays at three entries.
#
# ⭐ **And it changes NOTHING THE IMAGE CONTAINS.** An attestation is metadata
# ABOUT the build: the base digest, both toolchain pins and every `==` in
# `requirements.txt` are untouched. ⛔ **The pins still pin**: a stable id is
# QUOTABLE, never AUTHORITATIVE. `tests/docker/test_dev_provenance.py` asserts
# all of this.
BUILDX_NO_DEFAULT_ATTESTATIONS=1
export BUILDX_NO_DEFAULT_ATTESTATIONS

# ---------------------------------------------------------------------------
# ⛔ **THE IMAGE IS NAMED BY ITS INPUTS, NEVER BY ONE SHARED TAG.**
#
# ⚠️ One shared tag would be rewritten by `--build` from whichever checkout ran
# last, so two checkouts running this at once could start a container from each
# other's image, and a reading of the wrong image is a green gate about a
# different environment.
#
# ⭐ **The tag is `studyforge/dev:inputs-<IDENTITY>`**, IDENTITY a sha256 over the
# CONTENT of every build input: each file in the build context (`docker/dev/`)
# and each file the Dockerfile bind-mounts from the `project` context (`INPUTS`).
# Inputs differing by one byte name different tags, so no build can overwrite the
# tag another checkout runs; identical inputs name one tag, and either image is
# the environment both declared. ⛔ No path enters it: the listing hashed carries
# RELATIVE names only.
#
# ⚠️ **Hashed inside the Dockerfile's own pinned base**, read off its `FROM` line,
# because this file uses only `docker`, `id` and shell builtins — a host
# `sha256sum` is `shasum` on macOS. The checkout is mounted READ-ONLY and the
# container has no network.
#
# ⛔ **`INPUTS` is a CHECKED copy** of the Dockerfile's `from=project` mounts, and
# the identity has no `${VAR:-…}` escape, for the attestation variable's reason:
# `tests/docker/test_dev_image_identity.py` asserts both.
INPUTS="pyproject.toml README.md"
BASE=""
while IFS= read -r line; do
    case "$line" in
        "FROM "*) BASE=${line#FROM }; BASE=${BASE%% *} ;;
    esac
done < "$ROOT/docker/dev/Dockerfile"
# shellcheck disable=SC2016,SC2086  # the script is the container's; INPUTS splits
STUDYFORGE_DEV_IDENTITY=$(docker run --rm --network none \
    --user "$STUDYFORGE_UID:$STUDYFORGE_GID" \
    --volume "$ROOT:/inputs:ro" --workdir /inputs "$BASE" \
    sh -c 'set -eu; listing=$({ find docker/dev -type f | LC_ALL=C sort; printf "%s\n" "$@"; } | xargs -d "\n" sha256sum --); printf "%s\n" "$listing" | sha256sum' \
    identity $INPUTS </dev/null)
STUDYFORGE_DEV_IDENTITY=${STUDYFORGE_DEV_IDENTITY%% *}
case "$STUDYFORGE_DEV_IDENTITY" in
    *[!0-9a-f]* | "") echo "docker/dev/check: no identity derived from the build inputs" >&2; exit 1 ;;
esac
export STUDYFORGE_DEV_IDENTITY

# ⭐ **Every run PRINTS the image it runs**, so a reading quotes an identity and
# not a guard. ⚠️ On stderr, so a command's own stdout stays the command's.
echo "docker/dev/check: image studyforge/dev:inputs-$STUDYFORGE_DEV_IDENTITY" >&2

# ⚠️ A linked git worktree keeps its real git directory OUTSIDE the checkout —
# `.git` is a file naming it, not a directory. Mounting only the checkout
# would leave git unable to answer anything inside the container, and
# `tests/test_repository.py` asks it whether the ignore rules still keep the
# golden fixtures trackable. A plain clone needs none of this and
# gets none of it; if git is not installed on the host, nothing is added and
# the affected tests skip rather than lie.
GIT_MOUNT=""
if [ -f "$ROOT/.git" ] && command -v git >/dev/null 2>&1; then
    common=$(cd "$ROOT" && git rev-parse --git-common-dir 2>/dev/null || true)
    case "$common" in
        /*) GIT_MOUNT="--volume $common:$common:ro" ;;
    esac
fi

# ---------------------------------------------------------------------------
# ⛔ **THE OUTER BOUND: a hang becomes a non-zero exit.**
#
# ⚠️ A command can wedge rather than fail: a browser that is up and silent
# leaves a harness blocked on a read of a live pipe, and a read with no deadline
# never returns. ⚠️ **A hang is worse than a failure: it has no verdict at all.**
#
# ⛔ **This is the OUTER bound and NOT a deadlined read.** Deadlining a read
# changes the I/O path every reading in `tests/visual/` is taken against; a
# bound out here changes nothing any reading is taken against, which is why the
# two are separable.
#
# ⛔ **IT MUST NOT SWALLOW A REAL RED**, so nothing here touches the status:
#
#       a command that overruns        -> 124   (`timeout` terminated it)
#       one that ignores SIGTERM       -> 137   (it had to be killed, 128+9)
#       one that fails on its own      -> its OWN code, unchanged
#       one that succeeds              -> 0
#
# ⚠️ **Both overrun codes are outside pytest's range (0-5), so a wedged run is
# never confusable with a failing assertion.** ⛔ A wrapper that collapsed them
# into `1` would make a hang indistinguishable from a red.
#
# ⭐ **The bound runs INSIDE the container, for three reasons:**
#
#   1. ⛔ **The host's `timeout` is not one program.** It differs between
#      coreutils implementations, and on macOS there is none, so a bound whose
#      implementation depends on the host is an unpinned bound.
#   2. ⛔ **This file uses only `docker`, `id` and shell builtins**, so a
#      contributor needs Docker and nothing else. A host-side `timeout` would
#      break that.
#   3. ⭐ **It bounds the COMMAND and not the image BUILD.** `--build` below can
#      legitimately take minutes on a cold cache and a slow link; the thing that
#      hangs is a read inside the suite.
#
# ⚠️ **THE FIGURE IS DELIBERATELY LOOSE AND SAYS SO.** A healthy run of the
# whole suite in the pinned image takes about **57.66 s**, and `tests/visual/`
# alone about **8.44 s**; the default below, **1800 s**, is about **31x** the
# first. It is that loose because with
# `STUDYFORGE_DOCKER_TESTS=1` the command itself builds images and runs the
# suite inside them, and a contributor's hardware is not this hardware. ⭐ A
# bound that fires on a healthy run is a bound somebody deletes.
#
#       STUDYFORGE_CHECK_TIMEOUT=300 docker/dev/check     a tighter bound
#       STUDYFORGE_CHECK_TIMEOUT=0   docker/dev/check     no bound at all
#
# ⛔ `0` is GNU `timeout`'s own "no limit" and is not an invention of this file.
STUDYFORGE_CHECK_TIMEOUT=${STUDYFORGE_CHECK_TIMEOUT:-1800}

# ⚠️ `timeout` needs a command, so the no-argument case has to name one — and
# the one it names is the image's `CMD`. ⛔ A second copy of that is exactly the
# divergence this wrapper exists to prevent, so it is a CHECKED copy:
# `tests/docker/test_dev_check_timeout.py` asserts this line and the
# `Dockerfile`'s `CMD` stay the same command, and fails if either moves.
if [ "$#" -eq 0 ]; then
    set -- python3 -m pytest
fi

# ⚠️ `--build` on every run: the image is a declaration in `Dockerfile` and
# `requirements.txt`, and a stale image is a result attributed to a version of
# the environment nobody can name. The layers are cached, so the cost of being
# honest here is a second or two.
#
# ⛔ `--kill-after`, because a command that ignores SIGTERM would otherwise turn
# the bound back into the hang it replaces. The grace period is generous enough
# for pytest to print what it had.
# shellcheck disable=SC2086  # GIT_MOUNT is deliberately word-split, or empty
exec docker compose --file "$ROOT/docker/dev/compose.yaml" \
    run --rm --build $GIT_MOUNT dev \
    timeout --kill-after=30s "$STUDYFORGE_CHECK_TIMEOUT" "$@"
