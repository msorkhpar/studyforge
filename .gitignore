# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Generated study artifacts (not audio: whether a corpus commits its media is
# that corpus's own `media` policy).
*.unit.html
*.section.html
site.json

# Output of this repository's own runs: generated audio and discovery caches.
*.audio/
.studyforge/
.discovery-cache/

# The golden fixtures are the expected output the suite compares against, so
# they stay tracked.
!tests/fixtures/**
tests/fixtures/**/__pycache__/

# A contributor's scratch directory for logs, tables and backups. It is ignored
# so that a stray `.py` there does not fail ruff, and so that the personal-data
# floor, which reads every file git has not been told to ignore, does not read it.
.scratch/

# Editors / OS
.idea/
.vscode/
.DS_Store
